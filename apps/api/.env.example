NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# MongoDB (replica set for transactions)
MONGODB_URI=mongodb://localhost:27017/sadiyakargo?replicaSet=rs0

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-please-min-32-chars
JWT_REFRESH_SECRET=another-long-random-secret-please-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# CORS allow-list (comma-separated)
CORS_ORIGIN=http://localhost:3000

# Cookies
COOKIE_DOMAIN=
COOKIE_SECURE=false

# Rate limits (per IP)
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_GLOBAL_WINDOW_MS=60000
RATE_LIMIT_PUBLIC_TRACK_MAX=20
RATE_LIMIT_PUBLIC_TRACK_WINDOW_MS=60000

# Logging
LOG_LEVEL=info

# SMTP — leave SMTP_HOST empty in dev to log emails instead of sending
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Depo Yönetim <noreply@sadiyakargo.local>"

# Public web URL — used to build password-reset links
WEB_BASE_URL=http://localhost:3000

# Redis for BullMQ notification queue (leave empty for in-process fallback)
REDIS_URL=redis://localhost:6379

# Telegram bot — leave token empty in dev to log telegram payloads instead of sending
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Optional first-admin seed (used by migration 4). Leave empty to skip.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Administrator

# Multi-tenancy — default org id (24-hex; generated at first migration)
DEFAULT_ORG_ID=000000000000000000000001
