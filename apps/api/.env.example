# =============================================================================
# Sadiya Kargo — API environment template
# =============================================================================
#
# Validated by zod at startup (apps/api/src/config/env.ts). An invalid value
# crashes the process with a readable list of issues — do not silence them.
#
# Local dev:
#   cp apps/api/.env.example apps/api/.env
#   # then fill the REQUIRED values (search for "[REQUIRED]" below)
#
# Production (Railway/Fly/etc): copy the KEYS below into the service's
# "Variables" tab and paste real values there. Never commit a populated .env.
#
# Legend in comments:
#   [REQUIRED]   process exits if missing/invalid
#   [DEFAULT=x]  optional; falls back to x if unset
#   [LOCAL]      typical value when developing against docker-compose
#   [PROD]       what to use in production
# =============================================================================


# -----------------------------------------------------------------------------
# 1. Application
# -----------------------------------------------------------------------------

# Runtime mode. Drives pino formatting, audit middleware on/off, rate-limit
# enforcement, and a few other dev-only conveniences.
# [DEFAULT=development]   allowed: development | test | production
NODE_ENV=development

# HTTP port the API listens on.
# [DEFAULT=4000]   [PROD] usually overridden by the platform ($PORT on Railway)
PORT=4000

# URL prefix every route is mounted under. Web client's lib/env.ts must match.
# [DEFAULT=/api/v1]
API_PREFIX=/api/v1


# -----------------------------------------------------------------------------
# 2. MongoDB — REPLICA SET REQUIRED (for `session.withTransaction` in
#    shipments/transactions services). A standalone mongod will NOT work.
# -----------------------------------------------------------------------------

# [REQUIRED]
# [LOCAL]  docker-compose ships single-node rs0:
#          mongodb://localhost:27017/sadiyakargo?replicaSet=rs0
# [PROD]   MongoDB Atlas connection string (Atlas is multi-node by default):
#          mongodb+srv://USER:PASS@cluster.xxx.mongodb.net/sadiyakargo?retryWrites=true&w=majority
#
# Atlas checklist before pasting:
#   ✓ User created with `readWrite` on the `sadiyakargo` db (NOT atlasAdmin)
#   ✓ Network Access → IP allowlist contains Railway egress IPs, or 0.0.0.0/0
#     if the cluster is in a peered VPC (auth still gates access)
#   ✓ Continuous backups + PITR enabled (M10+)
MONGODB_URI=mongodb://localhost:27017/sadiyakargo?replicaSet=rs0


# -----------------------------------------------------------------------------
# 3. JWT — sign access (short-lived) + refresh (httpOnly cookie, rotated)
# -----------------------------------------------------------------------------

# [REQUIRED] Two DIFFERENT secrets, each ≥ 32 chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Rotate by issuing new values and restarting the API — all existing access
# tokens become invalid (refresh tokens too; users will be forced to re-login).
JWT_ACCESS_SECRET=replace-with-48-bytes-of-hex-randomness-min-32-chars
JWT_REFRESH_SECRET=different-from-access-also-48-bytes-of-hex-randomness

# Token lifetimes. Format: ms-style ("15m", "30d", "2h"). Access TTL drives
# how often the web client silently refreshes; refresh TTL is how long an
# idle user stays logged in.
# [DEFAULT=15m / 30d]
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d


# -----------------------------------------------------------------------------
# 4. CORS + Cookies
# -----------------------------------------------------------------------------

# Allowed origin(s) for browser requests (comma-separated, no trailing slash,
# include scheme). Wildcards are NOT supported — list every web origin.
# [DEFAULT=http://localhost:3000]
# [PROD]    https://app.sadiyakargo.uz
# Multi:    https://app.sadiyakargo.uz,https://admin.sadiyakargo.uz
CORS_ORIGIN=http://localhost:3000

# Domain attribute on the refresh cookie. Leave empty to scope to the API host.
# [LOCAL] empty
# [PROD]  set when web & api share a parent domain so the cookie spans both
#         (e.g. ".sadiyakargo.uz" when api is api.sadiyakargo.uz and web is
#         app.sadiyakargo.uz). Otherwise leave empty.
COOKIE_DOMAIN=

# Whether the cookie carries the `Secure` flag (HTTPS-only).
# [LOCAL=false]   dev runs plain HTTP on :4000
# [PROD=true]     mandatory — without HTTPS the cookie won't be sent back
COOKIE_SECURE=false


# -----------------------------------------------------------------------------
# 5. Rate limits (per IP). All values are sensible defaults; raise carefully.
# -----------------------------------------------------------------------------

# Auth routes (/auth/login, /auth/refresh, /auth/forgot, /auth/reset).
# Tight by design — protects against credential stuffing.
# [DEFAULT=10 attempts / 15 min]
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_MS=900000

# Everything else mounted under API_PREFIX.
# [DEFAULT=300 req / 1 min]
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_GLOBAL_WINDOW_MS=60000

# Public unauthenticated tracking endpoint (/public/track/:token).
# Recipients hit it from SMS/Telegram links — keep tight to block bots.
# [DEFAULT=20 req / 1 min]
RATE_LIMIT_PUBLIC_TRACK_MAX=20
RATE_LIMIT_PUBLIC_TRACK_WINDOW_MS=60000


# -----------------------------------------------------------------------------
# 6. Logging
# -----------------------------------------------------------------------------

# pino log level. `debug`/`trace` are noisy and leak request payloads — keep
# them out of production unless you're chasing a specific bug.
# [DEFAULT=info]   allowed: fatal | error | warn | info | debug | trace | silent
# [PROD]           info (or warn if log volume is an issue)
LOG_LEVEL=info


# -----------------------------------------------------------------------------
# 7. SMTP — used for password-reset emails and new-user invites
# -----------------------------------------------------------------------------

# Leave SMTP_HOST EMPTY to log emails to stdout instead of sending. Useful
# in dev and tests; in prod it silently breaks password reset, so set it.
# Recommended providers: Resend, Postmark, Brevo, Mailgun, Amazon SES.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# RFC-5322 "From" header. Display name + address. The sending domain must
# match SPF/DKIM records or major providers will spam-bucket the message.
# Example: "Sadiya Kargo <noreply@sadiyakargo.uz>"
SMTP_FROM=


# -----------------------------------------------------------------------------
# 8. Public web URL — used to build absolute links in emails + notifications
# -----------------------------------------------------------------------------

# Must be a valid URL (zod enforces `.url()`). No trailing slash.
# Used in:
#   - password-reset email link: `${WEB_BASE_URL}/reset-password/<token>`
#   - shipment tracking link in Telegram messages
# [DEFAULT=http://localhost:3000]
# [PROD]    https://app.sadiyakargo.uz   (typically same as CORS_ORIGIN)
WEB_BASE_URL=http://localhost:3000


# -----------------------------------------------------------------------------
# 9. Redis (BullMQ notification queue)
# -----------------------------------------------------------------------------

# Leave EMPTY for in-process synchronous fallback (notifications send right
# away, no persistence, no retries). Fine for dev; risky in prod — a single
# request can block on Telegram API latency, and any throw is lost.
# [LOCAL]   redis://localhost:6379   (docker-compose redis)
# [PROD]    rediss://default:PASS@HOST:6379   (Upstash, Railway Redis, etc.)
#           Atlas-style URIs with TLS work; `rediss://` enables it.
REDIS_URL=redis://localhost:6379

# BullMQ воркер запускается в том же процессе, что и API (см. server.ts).
# Concurrency = сколько уведомлений обрабатывается параллельно. 1 хватает
# на ≤10 уведомлений/час; поднять до 3-5 при массовых рассылках или
# bulk-смене статусов. Игнорируется, когда REDIS_URL пуст.
# [DEFAULT=1]
WORKER_CONCURRENCY=1


# -----------------------------------------------------------------------------
# 10. Telegram bot — outbound notifications to senders/carriers/recipients
# -----------------------------------------------------------------------------

# Leave EMPTY to log payloads instead of sending (dev mode).
# To create a bot in prod:
#   1. Talk to @BotFather on Telegram → /newbot → pick a name + username
#   2. Paste the token below; paste the @username (no leading @) into
#      TELEGRAM_BOT_USERNAME — the web client uses it to render the
#      "subscribe to notifications" deeplink for users.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=


# -----------------------------------------------------------------------------
# 11. First admin seed (idempotent, runs in migration 20260518000001)
# -----------------------------------------------------------------------------

# When BOTH ADMIN_EMAIL and ADMIN_PASSWORD are set, `npm run migrate:up`
# creates an admin user if the email doesn't exist yet. Re-running is safe.
# Once the admin exists, you can remove these vars — they're only consulted
# at migration time.
#
# [PROD] Use a real address (you'll receive password-reset emails there).
#        Generate a strong password: `openssl rand -base64 24` and store it
#        in 1Password/Bitwarden BEFORE running migrate:up.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Administrator


# -----------------------------------------------------------------------------
# 12. Multi-tenancy — default organization id (DON'T CHANGE WITHOUT MIGRATING)
# -----------------------------------------------------------------------------

# 24-character hex ObjectId. Every tenant-scoped record carries this in
# its `orgId` field. Today the system is single-tenant; this id is created
# by migration 20260517000002. Changing it mid-flight orphans all data.
# [DEFAULT=000000000000000000000001]
DEFAULT_ORG_ID=000000000000000000000001


# -----------------------------------------------------------------------------
# 13. S3-compatible object storage — lot photos
# -----------------------------------------------------------------------------

# The API stores uploaded photos here and hands out 1-hour presigned GET
# URLs (LOT_PHOTO_PRESIGNED_TTL_SECONDS below). Any S3-compatible service
# works: MinIO (local), Cloudflare R2, Backblaze B2, Wasabi, AWS S3.
#
# [LOCAL]   docker-compose minio creates the bucket automatically.
#
# [PROD: Cloudflare R2 — recommended, zero egress fees]
#   1. Dashboard → R2 → Create bucket "sadiyakargo-photos"
#   2. Manage API tokens → Create with read+write on this bucket
#   3. Paste below:
#      S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#      S3_REGION=auto
#      S3_BUCKET=sadiyakargo-photos
#      S3_ACCESS_KEY=<token access key>
#      S3_SECRET_KEY=<token secret>
#      S3_FORCE_PATH_STYLE=true
#
# [PROD: AWS S3]
#      S3_ENDPOINT=https://s3.<region>.amazonaws.com
#      S3_REGION=eu-central-1   # or your region
#      S3_FORCE_PATH_STYLE=false   # AWS prefers virtual-hosted-style
#
# Must be a valid URL (zod `.url()` check). No trailing slash.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=sadiyakargo-photos
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345

# Path-style URLs: required for MinIO, R2, Wasabi, B2. Only AWS S3 prefers
# virtual-hosted-style, in which case set to "false".
# [DEFAULT=true]
S3_FORCE_PATH_STYLE=true


# -----------------------------------------------------------------------------
# 14. Lot photo upload limits
# -----------------------------------------------------------------------------

# Per-file size limit in bytes. Defaults to 10 MB. The web client mirrors
# this in PHOTO_MAX_BYTES (apps/web/src/routes/depo.tsx) for early rejection.
# [DEFAULT=10485760]   = 10 * 1024 * 1024
LOT_PHOTO_MAX_BYTES=10485760

# Maximum number of photos per lot.
# [DEFAULT=10]
LOT_PHOTO_MAX_COUNT=10

# How long a presigned GET URL stays valid (in seconds). 1h is the default —
# don't raise it without security review (longer TTL = wider replay window).
# [DEFAULT=3600]
LOT_PHOTO_PRESIGNED_TTL_SECONDS=3600


# =============================================================================
# Pre-flight checklist (run through this before `npm run start:api` in prod)
# =============================================================================
#
#   [ ] NODE_ENV=production
#   [ ] JWT_ACCESS_SECRET and JWT_REFRESH_SECRET are fresh, distinct, ≥48 chars
#   [ ] MONGODB_URI points at Atlas (or another replica set), backups enabled
#   [ ] CORS_ORIGIN lists every prod web origin, no localhost left in
#   [ ] WEB_BASE_URL is the public HTTPS web URL
#   [ ] COOKIE_SECURE=true (and the API is behind HTTPS)
#   [ ] COOKIE_DOMAIN set if web/api are on sibling subdomains
#   [ ] LOG_LEVEL is "info" or "warn" — never "debug"/"trace"
#   [ ] SMTP_* configured (else password reset silently breaks)
#   [ ] REDIS_URL set (else notification failures are lost)
#   [ ] TELEGRAM_BOT_TOKEN + USERNAME set (else customer notifications no-op)
#   [ ] S3_* points at R2/S3, not MinIO; credentials are write-scoped
#   [ ] ADMIN_EMAIL/PASSWORD set ONLY for the first migrate:up, then removed
#   [ ] Run `npm run migrate:up` once after deploy (creates indexes + seeds)
#   [ ] Sentry DSN wired in server.ts (add when you have one)
#   [ ] Health check `/api/v1/health` reachable from UptimeRobot
#
# =============================================================================
